FLASK_ENV=development
SECRET_KEY=change-me-in-development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/grapevyne
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=session
# Leave empty unless every deployment hostname requires a shared cookie domain.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=7
# Session refresh is fixed to false by application policy.
# Enable only behind a trusted reverse proxy that sets forwarded headers.
TRUST_PROXY_HEADERS=false
