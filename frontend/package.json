{
  "name": "grapevyne-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:chromium": "node scripts/run-e2e.mjs --project=desktop-chromium --project=mobile-chromium --project=reduced-motion-chromium",
    "test:e2e:cross-browser": "node scripts/run-e2e.mjs --project=desktop-firefox --project=desktop-webkit --project=mobile-webkit --grep=@smoke",
    "test:e2e:headed": "node scripts/run-e2e.mjs --project=desktop-chromium --headed",
    "test:a11y": "node scripts/run-e2e.mjs e2e/accessibility.spec.ts --project=desktop-chromium",
    "test:visual": "GRAPEVYNE_VISUAL_BASELINES=1 node scripts/run-e2e.mjs e2e/visual.spec.ts --project=reduced-motion-chromium",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "npm run verify:assets && npm run lint && npm run test && npm run build && npm run verify:bundle"
  },
  "dependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@tanstack/react-query": "5.59.16",
    "@vitejs/plugin-react": "^4.3.1",
    "framer-motion": "^12.38.0",
    "gsap": "3.12.7",
    "lenis": "1.1.20",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "three": "0.169.0",
    "vite": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "3.2.6"
  },
  "overrides": {
    "stats-gl": {
      "three": "0.169.0"
    }
  }
}
